{
  "mcpServers": {
    "slack": {
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "callbackUrl": "http://localhost:3118/callback"
      }
    },
    "ibotta-mcp": {
      "url": "https://ops.int.ibops.net/ibotta-mcp/mcp",
      "toolExposure": {
        "ibotta_tf_list_modules": "direct",
        "ibotta_tf_get_module": "direct",
        "ibotta_ams_list_accounts": "direct",
        "ibotta_ams_get_account": "direct"
      }
    },
    "miro-mcp": {
      "url": "https://mcp.miro.com/"
    },
    "aws-docs": {
      "url": "https://aws-mcp.us-east-1.api.aws/mcp",
      "description": "AWS docs, skills, and region availability (unauthenticated AWS MCP Server).",
      "toolExposure": {
        "aws___run_script": "hidden",
        "aws___get_presigned_url": "hidden",
        "aws___get_tasks": "hidden"
      }
    },
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1",
        "--read-only"
      ],
      "enabled": false
    },
    "steampipe": {
      "command": "npx",
      "args": ["-y", "@turbot/steampipe-mcp"]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_HOST",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}" }
    }
  }
}
